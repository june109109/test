{
  "title": "Study Python runtime",
  "uid": "study-python-runtime",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Loop lag p99 (sampling delay)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(study_loop_lag_seconds_bucket[1m])))",
          "legendFormat": "{{route}} {{status}} {{instance}} 0"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "AnyIO borrowed / total",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "study_thread_tokens_borrowed",
          "legendFormat": "{{route}} {{status}} {{instance}} 0"
        },
        {
          "refId": "B",
          "expr": "study_thread_tokens_total",
          "legendFormat": "{{route}} {{status}} {{instance}} 1"
        },
        {
          "refId": "C",
          "expr": "study_thread_route_inflight",
          "legendFormat": "{{route}} {{status}} {{instance}} 2"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Process RSS (single worker per target)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"study-python\"}",
          "legendFormat": "{{route}} {{status}} {{instance}} 0"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP request rate by route / status",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route,status) (rate(study_http_requests_total[1m]))",
          "legendFormat": "{{route}} {{status}} {{instance}} 0"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Handler duration p95 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,route) (rate(study_http_duration_seconds_bucket[1m])))",
          "legendFormat": "{{route}} {{status}} {{instance}} 0"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scrape target health",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"study-python\"}",
          "legendFormat": "{{route}} {{status}} {{instance}} 0"
        }
      ]
    }
  ]
}
